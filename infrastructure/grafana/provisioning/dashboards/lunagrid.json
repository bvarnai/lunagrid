      },
      "id": 1,
      "title": "Grid Power State (B-Tariff Availability Timeline)",
      "type": "state-timeline",
      "datasource": {
        "type": "influxdb",
        "uid": "InfluxDB-2"
      },
      "targets": [
        {
          "datasource": {
            "type": "influxdb",
            "uid": "InfluxDB-2"
          },
          "query": "from(bucket: \"lunagrid-telemetry\")\n  |> range(start: v.timeRangeStart, stop: v.timeRangeStop)\n  |> filter(fn: (r) => r[\"_measurement\"] == \"mqtt_consumer\")\n  |> filter(fn: (r) => r[\"_field\"] == \"metrics_grid_active\" or r[\"_field\"] == \"grid_active\")\n  |> aggregateWindow(every: v.windowPeriod, fn: last, createEmpty: false)\n  |> yield(name: \"last\")",
          "refId": "A"
        }
      ],
      "options": {
        "showValues": "auto",
        "align": "left",
        "rowHeight": 0.7,
        "mergeValues": true
      },
      "fieldConfig": {
        "defaults": {
          "custom": {
            "lineWidth": 0,
            "fillOpacity": 70,
            "spanNulls": false,
            "insertNulls": false
          },
          "mappings": [
            {
              "type": "value",
              "options": {
                "true": {
                  "text": "OFF-PEAK (B-Tariff Active)",
                  "color": "green"
                },
                "false": {
                  "text": "ON-PEAK (B-Tariff Inactive)",
                  "color": "red"
                }
              }
            }
          ]
        },
        "overrides": []
      }
    },
    {
      "collapsed": false,
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 8
      },
      "id": 2,
      "title": "Wi-Fi Signal Strength (RSSI)",
      "type": "timeseries",
      "datasource": {
        "type": "influxdb",
        "uid": "InfluxDB-2"
      },
      "targets": [
        {
          "datasource": {
            "type": "influxdb",
            "uid": "InfluxDB-2"
          },
          "query": "from(bucket: \"lunagrid-telemetry\")\n  |> range(start: v.timeRangeStart, stop: v.timeRangeStop)\n  |> filter(fn: (r) => r[\"_measurement\"] == \"mqtt_consumer\")\n  |> filter(fn: (r) => r[\"_field\"] == \"status_wifi_rssi\")\n  |> aggregateWindow(every: v.windowPeriod, fn: mean, createEmpty: false)\n  |> yield(name: \"mean\")",
          "refId": "A"
        }
      ],
      "options": {
        "tooltip": {
          "mode": "single",
          "sort": "none"
        },
        "legend": {
          "showLegend": true,
          "displayMode": "list",
          "placement": "bottom",
          "calcs": ["mean", "min", "max"]
        }
      },
      "fieldConfig": {
        "defaults": {
          "unit": "dBm",
          "color": {
            "mode": "palette-classic"
          },
          "custom": {
            "drawStyle": "line",
            "lineInterpolation": "smooth",
            "fillOpacity": 10
          }
        },
        "overrides": []
      }
    },
    {
      "collapsed": false,
      "gridPos": {
        "h": 8,
